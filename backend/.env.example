# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/helmet_db
SECRET_KEY=put-a-long-random-string-here
ACCESS_TOKEN_MINUTES=1440

# CCTV monitoring (the worker runs on a PC near the camera and reports to this server)
# CCTV_WORKER_KEY=<long random string, same value on the server and on the PC>
# CCTV_OFFLINE_MINUTES=5
# TELEGRAM_BOT_TOKEN=<from @BotFather>
# TELEGRAM_CHAT_ID=<your chat id>
# On the PC only: CCTV_SERVER_URL=https://your-server.example.com

# Push notifications to the phone app (optional, needs a Firebase project; see deploy/README_DEPLOY.md)
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_SERVICE_ACCOUNT_FILE=/opt/helmet/fcm-service-account.json
