[Unit]
Description=Helmet detection API (FastAPI + YOLO)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=helmet
Group=helmet
WorkingDirectory=/opt/helmet/backend
Environment=HOME=/opt/helmet
Environment=PYTHONUNBUFFERED=1
# One worker on purpose: videos are analysed one at a time in this process and the model is loaded once.
ExecStart=/opt/helmet/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/helmet

[Install]
WantedBy=multi-user.target
